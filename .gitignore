SNT_extract_changes.txt
SNT Process/
.vscode/
venv/
uv.lock
__pycache__/
*.yaml

# Jupyter stuff -------------------------

# Windows security metadata files attached to Jupyter notebooks
# (on Linux and macOS, this pattern has no effect)
*.ipynb:Zone.Identifier

# Ignore Jupyter Notebook checkpoints
*.ipynb_checkpoints/


# Test and temporary stuff ------------------------
**/old/
**/ignore/
**/test/
**/to_find_better_place/
**/WIP/
**/tmp/
**/test_stuff*
**/[Tt]est*

# Avoid sharing sensitive data --------------------
*.csv
*.CSV
*.xlsx
*.xls
*.yml
*.ipynb:Zone.Identifier
*.r:Zone.Identifier
*.py:Zone.Identifier
*:Zone.Identifier

# Local dev environment ---------------------------
# Negated after BOTH *.yaml (above) and *.yml — in .gitignore the last matching
# pattern wins, so this must come last or the file never reaches a clone.
!dev/environment.yml
# ...and the CI deployment workflows: without this, a new push_snt_*.yaml is ignored
# (the existing ones are only tracked because they were committed before *.yaml).
!.github/workflows/*.yaml

# # Claude Code -----------------
# CLAUDE.md
# .claude/

# Config file -----------------
# ignore .json files (country data)...
*.json
# ...except the archived per-country config copies and old-format SNT_metadata.json
# (examples only, nothing reads them; see deprecated/configuration/README.md).
!deprecated/configuration/*.json
# ...or the shared Claude Code settings, which must reach every clone for the
# destructive-git guardrail to be active (see CLAUDE.md "Agent guardrails").
!.claude/settings.json
# ...or the JSON Schemas, skeletons and reference examples under contracts/. These are
# documentation, not country data: an example holds no real values, only the layer
# catalogue and the {COUNTRY_CODE} placeholder (see contracts/README.md).
# The ** is load-bearing: one subfolder per contract (contracts/snt_metadata_json/,
# ...), and a single-* negation would not reach inside them — the files would be
# silently untracked, with git status never mentioning them.
!contracts/**/*.json
# ...or the SNT Explorer master list, fetched from this repo by snt_metadata_json_trim and
# shipped with each release. Layer definitions only, no country data (see catalogs/README.md).
# Named exactly, so a stray data .json dropped into catalogs/ is still ignored.
!catalogs/SNT_metadata_master.json

# R ----------------------------------------
*.rds
*.RDS 
# except any R script 
!*.R
!*.r 

