SNT_extract_changes.txt
SNT Process/
.vscode/
venv/
uv.lock
__pycache__/
*.yaml

# Jupyter stuff -------------------------

# Windows security metadata files attached to Jupyter notebooks
# (on Linux and macOS, this pattern has no effect)
*.ipynb:Zone.Identifier

# Ignore Jupyter Notebook checkpoints
*.ipynb_checkpoints/


# Test and temporary stuff ------------------------
**/old/
**/ignore/
**/test/
**/to_find_better_place/
**/WIP/
**/tmp/
**/test_stuff*
**/[Tt]est*

# Avoid sharing sensitive data --------------------
*.csv
*.CSV
*.xlsx
*.xls
*.yml
*.ipynb:Zone.Identifier
*.r:Zone.Identifier
*.py:Zone.Identifier
*:Zone.Identifier

# Local dev environment ---------------------------
# Negated after BOTH *.yaml (above) and *.yml — in .gitignore the last matching
# pattern wins, so this must come last or the file never reaches a clone.
!dev/environment.yml

# GitHub Actions ----------------------------------
# Also negated after *.yaml above, for the same reason.
#
# Why this is needed: the 20 push_snt_*.yaml workflows are tracked only because
# they were added BEFORE the `*.yaml` rule — git ignores patterns for files
# already in the index. Any NEW workflow file was therefore invisible to git:
# `git add` did nothing, no warning was printed, and CI silently never ran it.
# Confirm with:  git check-ignore -v .github/workflows/<new>.yaml
!.github/workflows/*.yaml

# # Claude Code -----------------
# CLAUDE.md
# .claude/

# Config file -----------------
# ignore .json files unless if SNT_config.json
*.json
!configuration/SNT_config_*.json
# ...or the shared Claude Code settings, which must reach every clone for the
# destructive-git guardrail to be active (see CLAUDE.md "Agent guardrails").
!.claude/settings.json

# R ----------------------------------------
*.rds
*.RDS 
# except any R script 
!*.R
!*.r 

